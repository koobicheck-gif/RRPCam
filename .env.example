# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars
NEXTAUTH_URL=http://localhost:3000

# Google Service Account JSON (base64 encoded or raw JSON string)
# Generate from Google Cloud Console > IAM > Service Accounts
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Google Drive - Root folder ID where all project folders will be created
# Create a folder in Drive and get its ID from the URL
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_folder_id

# Google Sheets - The spreadsheet ID used as database
# Create a sheet named "projects" and get the ID from the URL
GOOGLE_SHEETS_ID=your_spreadsheet_id
